{
  "id": "com.paraglide.connector",
  "name": "Paraglide Connector",
  "version": "1.0.0",
  "main": "index.html",
  "manifestVersion": 5,
  "host": [
    {
      "app": "PS",
      "minVersion": "24.2.0",
      "data": {
        "apiVersion": 2,
        "loadEvent": "startup",
        "enableMenuRecording": true
      }
    }
  ],
  "icons": [
    {
      "width": 23, "height": 23,
      "path": "icons/dark.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium"]
    },
    {
      "width": 23, "height": 23,
      "path": "icons/light.png",
      "scale": [1, 2],
      "theme": ["lightest", "light"]
    },
    {
      "width": 48, "height": 48,
      "path": "icons/plugin-icon.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium", "lightest", "light", "all"],
      "species": ["pluginList"]
    }
  ],
  "entrypoints": [
    {
      "type": "command",
      "id": "toggleConnection",
      "label": {
        "default": "Toggle Paraglide Connection"
      }
    },
    {
      "type": "panel",
      "id": "mainPanel",
      "label": {
        "default": "Paraglide"
      },
      "icons": [
        {
          "width": 23, "height": 23,
          "path": "icons/dark.png",
          "scale": [1, 2],
          "theme": ["darkest", "dark", "medium"]
        },
        {
          "width": 23, "height": 23,
          "path": "icons/light.png",
          "scale": [1, 2],
          "theme": ["lightest", "light"]
        }
      ],
      "minimumSize": { "width": 220, "height": 200 },
      "maximumSize": { "width": 240, "height": 220 },
      "preferredDockedSize": { "width": 220, "height": 200 },
      "preferredFloatingSize": { "width": 240, "height": 220 }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": ["localhost", "127.0.0.1"]
    },
    "clipboard": "readAndWrite"
  }
}
